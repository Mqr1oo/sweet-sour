// Configurarea Cloudflare Workers (site static). Fara fisierul asta wrangler
// ghiceste setarile: publica si .git/, si nu serveste paginile 404 proprii.
{
  "name": "sweet-sour",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
